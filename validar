name: Validar códigos de ESPN

# Se corre a mano, desde la pestaña Actions. No necesita instalar nada.
on:
  workflow_dispatch:

jobs:
  validar:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: Probar cada código de liga
        run: |
          {
            echo '## Resultado'
            echo ''
            echo '```'
            node scripts/validar-endpoints.js
            echo '```'
            echo ''
            echo 'Los códigos que devolvieron eventos o tablas van a `config.json` con `"verificado": true` y `"activa": true`.'
          } >> $GITHUB_STEP_SUMMARY
